{
  "name": "restaurant-desktop-app",
  "version": "1.0.0",
  "description": "Restaurant Management Desktop Application",
  "main": "app/main/index.js",
  "scripts": {
    "start": "bash -c 'unset ELECTRON_RUN_AS_NODE && unset ELECTRON_NO_ATTACH_CONSOLE && electron --disable-gpu --disable-software-rasterizer --no-sandbox app/main/index.js'",
    "dev": "bash -c 'unset ELECTRON_RUN_AS_NODE && unset ELECTRON_NO_ATTACH_CONSOLE && concurrently \"vite --config vite.config.js\" \"electron --disable-gpu --disable-software-rasterizer --no-sandbox app/main/index.js\"'",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:renderer": "vite build --config vite.config.js",
    "build:win": "npm run build:renderer && electron-builder --win --publish never",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build": "npm run build:renderer && electron-builder"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.restaurant.desktop",
    "productName": "Restaurant Manager",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "app/**/*",
      "!app/renderer/src/**",
      "!app/renderer/index.html",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.7.0",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.0.0",
    "lucide-react": "^0.263.0",
    "nodemailer": "^8.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zustand": "^5.0.0"
  }
}
